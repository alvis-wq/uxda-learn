# --- Main Supabase project -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Scripts only (migrations, type generation via the Management API). Not needed by the app.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Google Workspace domain(s) allowed to sign in (comma-separated). Required at runtime:
# Google `hd` hint, auth-callback re-check, test user emails, error copy.
# The DB trigger checks the allowed_email_domains table — after changing this, run
# `npm run seed:domains` (and `-- --test-project` for the test project).
ALLOWED_EMAIL_DOMAINS=uxdesignagency.com
# Used by `npm run seed:admins` (comma-separated).
ADMIN_EMAILS=alvis@uxdesignagency.com

# Academy: Claude drafts the 5-question quizzes (Admin → Academy, and the spreadsheet import). Server-only.
# Without it, editors write the questions by hand.
ANTHROPIC_API_KEY=

# Local development/testing only — must be false or absent in production
ENABLE_TEST_LOGIN=true

# --- Test Supabase project (E2E + integration tests) -----------------------
# A SEPARATE project: tests create users, submissions and uploads. If these are unset,
# `npm run test:e2e` and `npm run test:integration` skip. Pointing them at the main
# project is refused.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
# For `npm run db:push -- --test-project` (and db:check / db:types). The access token
# falls back to SUPABASE_ACCESS_TOKEN.
TEST_SUPABASE_PROJECT_REF=
TEST_SUPABASE_ACCESS_TOKEN=
